cd() {
  builtin cd "$@" && ls
}
function tm() {
  mate
  if [[ $(ls -l | grep tmproj | wc -l) -eq 0 ]]
  then mate .
  else open *.tmproj
  fi
}
function eza_ll() {
  if [ $# -eq 0 ]; then
      command eza -laTL 1 .
  else
      command eza -laTL 1 "$@"
  fi
}
chrome-no-cors() {
    if [[ -z "$1" ]]; then
        echo "Usage: chrome-no-cors <url>"
        return 1
    fi

    local temp_dir=$(mktemp -d)
    /Applications/Google\ Chrome.app/Contents/MacOS/Google\ Chrome \
        --disable-web-security \
        --disable-features=VizDisplayCompositor \
        --user-data-dir="$temp_dir" \
        --no-first-run \
        --no-default-browser-check \
        --disable-sync \
        --disable-background-networking \
        --disable-background-timer-throttling \
        --disable-backgrounding-occluded-windows \
        --disable-renderer-backgrounding \
        --disable-field-trial-config \
        --disable-ipc-flooding-protection \
        "$1" > /dev/null 2>&1 &
}
chrome-isolated() {
    /Applications/Google\ Chrome.app/Contents/MacOS/Google\ Chrome \
        --user-data-dir="/tmp/isolated-chrome" \
        --no-first-run \
        --no-default-browser-check \
        --disable-sync
}

git-squash-feature() {
  # 1. Fetch the latest from the remote to ensure origin/main is up to date
  git fetch origin && \
  # 2. Find the common ancestor and reset softly, staging all changes
  git reset --soft $(git merge-base HEAD origin/main) && \
  # 3. Commit the staged changes with the message you provide
  git commit -m "$1"
}

cjq() {
  curl -s --show-error -o >(jq -Rsr '. as $x | try fromjson catch $x') $@
}

# SSH with TMUX integration for multi-paned, resumable sessions
tssh() {
  if [ $# -eq 0 ]; then
    echo "Usage: tssh user@server"
    return 1
  fi
  ssh "$@" -t 'tmux -CC new-session -A -s main || tmux -CC attach -t main'
}

tsh-reissue() {
  local host="${1:?usage: tsh-reissue SSH_HOST [CALLBACK_PORT]}"
  local port="${2:-52080}"

  if [[ "$port" != <-> ]] || (( port < 1024 || port > 65535 )); then
    print -u2 "invalid callback port: $port"
    return 64
  fi

  local remote_cmd="
    set -e
    tsh login --force \
      --proxy=nv-stg-hw.teleport.sh:443 \
      --user=gmaddern@nvidia.com \
      --ttl=480 \
      --browser=none \
      --bind-addr=127.0.0.1:${port} \
      --callback=http://127.0.0.1:${port}
    tsh kube login hou2-prod1
    kubectl get --raw=/readyz >/dev/null
    echo
    tsh status
  "

  ssh -tt \
    -o ExitOnForwardFailure=yes \
    -o ServerAliveInterval=15 \
    -o ServerAliveCountMax=3 \
    -L "127.0.0.1:${port}:127.0.0.1:${port}" \
    "$host" "$remote_cmd"
}

# Keep local SSH forwards alive independently of remote-tmux.
# Usage: remote-tunnel <ssh-host> <port|local-port:remote-port> [...]
# Run in a dedicated terminal; Ctrl-C stops reconnecting.
remote-tunnel() (
    emulate -L zsh
    local host="$1" spec local_port remote_port rc
    local -a forwards mappings
    local -A seen

    _remote_tunnel_log() {
        print -ru2 -- "[$(date '+%Y-%m-%d %H:%M:%S %Z')] $*"
    }

    if (( $# < 2 )) || [[ -z "$host" || "$host" == -* ]]; then
        _remote_tunnel_log 'Usage: remote-tunnel <ssh-host> <port|local-port:remote-port> [...]'
        return 2
    fi
    shift

    for spec in "$@"; do
        local_port="${spec%%:*}"
        remote_port="${spec#*:}"
        if [[ "$local_port" != <-> || "$remote_port" != <-> ]] ||
           (( ${#local_port} > 5 || ${#remote_port} > 5 )); then
            _remote_tunnel_log "Invalid forward: $spec (expected port or local-port:remote-port)"
            return 2
        fi
        local_port=$(( 10#$local_port ))
        remote_port=$(( 10#$remote_port ))
        if (( local_port < 1 || local_port > 65535 || remote_port < 1 || remote_port > 65535 )); then
            _remote_tunnel_log "Invalid forward: $spec (ports must be 1–65535)"
            return 2
        fi
        if [[ -n "${seen[$local_port]}" ]]; then
            _remote_tunnel_log "Duplicate local port: $local_port"
            return 2
        fi
        seen[$local_port]=1
        mappings+=("127.0.0.1:${local_port} -> ${host}:localhost:${remote_port}")
        forwards+=(-L "127.0.0.1:${local_port}:localhost:${remote_port}")
    done

    for spec in "${mappings[@]}"; do
        _remote_tunnel_log "Forward: $spec"
    done

    # Subshell keeps these traps isolated from the interactive shell.
    trap '_remote_tunnel_log "Stopped."; exit 130' INT
    trap '_remote_tunnel_log "Stopped."; exit 143' TERM
    trap '_remote_tunnel_log "Stopped."; exit 129' HUP
    while true; do
        _remote_tunnel_log "Connecting to $host…"
        command ssh -N -T \
            -o ControlMaster=no -o ControlPath=none -o ControlPersist=no \
            -o ForkAfterAuthentication=no \
            -o PermitLocalCommand=yes \
            -o 'LocalCommand=echo "[$(date +"%%Y-%%m-%%d %%H:%%M:%%S %%Z")] Connected; local forwards ready."' \
            -o ExitOnForwardFailure=yes \
            -o ServerAliveInterval=15 -o ServerAliveCountMax=3 \
            -o TCPKeepAlive=yes -o ConnectTimeout=15 \
            "${forwards[@]}" "$host" 2> >(
                while IFS= read -r line; do
                    _remote_tunnel_log "$line"
                done
            )
        rc=$?
        if (( rc == 129 || rc == 130 || rc == 143 )); then
            _remote_tunnel_log "Stopped (exit $rc)."
            return "$rc"
        fi
        _remote_tunnel_log "Tunnel to $host ended (exit $rc); retrying in 2 seconds. Ctrl-C to stop."
        sleep 2
    done
)
