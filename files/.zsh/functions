cd() {
  builtin cd "$@" && ls
}
function tm() {
  mate
  if [[ $(ls -l | grep tmproj | wc -l) -eq 0 ]]
  then mate .
  else open *.tmproj
  fi
}
function eza_ll() {
  if [ $# -eq 0 ]; then
      command eza -laTL 1 .
  else
      command eza -laTL 1 "$@"
  fi
}
chrome-no-cors() {
    if [[ -z "$1" ]]; then
        echo "Usage: chrome-no-cors <url>"
        return 1
    fi

    local temp_dir=$(mktemp -d)
    /Applications/Google\ Chrome.app/Contents/MacOS/Google\ Chrome \
        --disable-web-security \
        --disable-features=VizDisplayCompositor \
        --user-data-dir="$temp_dir" \
        --no-first-run \
        --no-default-browser-check \
        --disable-sync \
        --disable-background-networking \
        --disable-background-timer-throttling \
        --disable-backgrounding-occluded-windows \
        --disable-renderer-backgrounding \
        --disable-field-trial-config \
        --disable-ipc-flooding-protection \
        "$1" > /dev/null 2>&1 &
}
chrome-isolated() {
    /Applications/Google\ Chrome.app/Contents/MacOS/Google\ Chrome \
        --user-data-dir="/tmp/isolated-chrome" \
        --no-first-run \
        --no-default-browser-check \
        --disable-sync
}

git-squash-feature() {
  # 1. Fetch the latest from the remote to ensure origin/main is up to date
  git fetch origin && \
  # 2. Find the common ancestor and reset softly, staging all changes
  git reset --soft $(git merge-base HEAD origin/main) && \
  # 3. Commit the staged changes with the message you provide
  git commit -m "$1"
}

cjq() {
  curl -s --show-error -o >(jq -Rsr '. as $x | try fromjson catch $x') $@
}

# SSH with TMUX integration for multi-paned, resumable sessions
tssh() {
  if [ $# -eq 0 ]; then
    echo "Usage: tssh user@server"
    return 1
  fi
  ssh "$@" -t 'tmux -CC new-session -A -s main || tmux -CC attach -t main'
}

tsh-reissue() {
  local host="${1:?usage: tsh-reissue SSH_HOST [CALLBACK_PORT]}"
  local port="${2:-52080}"

  if [[ "$port" != <-> ]] || (( port < 1024 || port > 65535 )); then
    print -u2 "invalid callback port: $port"
    return 64
  fi

  local remote_cmd="
    set -e
    tsh login --force \
      --proxy=nv-stg-hw.teleport.sh:443 \
      --user=gmaddern@nvidia.com \
      --ttl=480 \
      --browser=none \
      --bind-addr=127.0.0.1:${port} \
      --callback=http://127.0.0.1:${port}
    tsh kube login hou2-prod1
    kubectl get --raw=/readyz >/dev/null
    echo
    tsh status
  "

  ssh -tt \
    -o ExitOnForwardFailure=yes \
    -o ServerAliveInterval=15 \
    -o ServerAliveCountMax=3 \
    -L "127.0.0.1:${port}:127.0.0.1:${port}" \
    "$host" "$remote_cmd"
}
