[user]
	name = Glen Maddern
	email = gmaddern@nvidia.com
[color]
	ui = auto
[core]
	excludesFile = /Users/gmaddern/.gitignore
	pager = "delta --syntax-theme=\"TwoDark\" --plus-style=\"syntax bold #001701\" --plus-emph-style=\"syntax bold #064000\" --minus-style=\"syntax bold #240002\" --minus-emph-style=\"syntax bold #64000E\""
[github]
	user = geelen
[filter "media"]
	clean = git-media-clean %f
	smudge = git-media-smudge %f
[filter "lfs"]
	clean = git-lfs clean %f
	smudge = git-lfs smudge %f
	required = true
[init]
	defaultBranch = main
[alias]
	bv = branch -v --sort=-committerdate
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
