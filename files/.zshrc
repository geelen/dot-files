# zmodload zsh/zprof

typeset -g POWERLEVEL9K_DISABLE_SSH_CONTEXT=true

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

. ~/.zsh/rc

export PATH="$HOME/.yarn/bin:$PATH"

# Wasmer
export WASMER_DIR="/home/glen/.wasmer"
[ -s "$WASMER_DIR/wasmer.sh" ] && source "$WASMER_DIR/wasmer.sh"

# zprof

# opencode
export PATH=/Users/glenmaddern/.opencode/bin:$PATH

# bun completions
[ -s "/Users/glenmaddern/.bun/_bun" ] && source "/Users/glenmaddern/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"



# pnpm
export PNPM_HOME="/Users/glenmaddern/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac
# pnpm end

# alias claude='claude-trace --include-all-requests --no-open --run-with claude-code'

# The next line updates PATH for the Google Cloud SDK.
if [ -f '/Users/glenmaddern/google-cloud-sdk/path.zsh.inc' ]; then . '/Users/glenmaddern/google-cloud-sdk/path.zsh.inc'; fi

# The next line enables shell command completion for gcloud.
if [ -f '/Users/glenmaddern/google-cloud-sdk/completion.zsh.inc' ]; then . '/Users/glenmaddern/google-cloud-sdk/completion.zsh.inc'; fi

# Generated by Groq bootstrap; START; DO NOT EDIT.
source $HOME/.config/groq-bootstrap/groq-bootstrap.zsh
# Generated by Groq bootstrap; END; DO NOT EDIT.

eval "$(tree-me shellenv 2>/dev/null)"
